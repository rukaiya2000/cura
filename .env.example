# Cura — credentials template.
#
#   cp .env.example .env     then fill in .env
#   .venv/bin/python -m skillforge.config       shows what's set and what each unlocks
#
# .env is gitignored and must stay that way. Values are never printed by the config
# report — it only reports whether a key is set.
#
# None of these ever reach forged code. The sandbox launches with a scrubbed environment,
# so a generated skill reaching for os.environ finds nothing — verified in
# tests/test_milestone1.py, not merely intended.
#
# Nothing here is required to run the project. Every demo and all 315 tests pass with no
# credentials at all, against the in-memory clinic in adapters/fake_clinic.py.


# ── Code generation ───────────────────────────────────────────────────────────
# Unlocks: Claude writing skills for real instead of canned attempts.
#   .venv/bin/python scripts/consult_demo.py --live
# Without it, ScriptedGenerator runs and everything still works end to end.
ANTHROPIC_API_KEY=

# Generation effort: low | medium | high | xhigh | max. Defaults to high.
SKILLFORGE_EFFORT=


# ── Scalekit: login, and the tools the doctor may act through ─────────────────
# One provider does both jobs on purpose. The doctor signs in through Scalekit, and the
# subject of that verified token *is* the identifier its tool APIs take — so the login
# identity and the connected accounts cannot drift apart. A separate identity provider
# would mean maintaining a mapping table, and when that drifts the symptom is writing to
# the wrong clinician's records.
#
# Dashboard → Settings → API credentials.
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
SCALEKIT_ENVIRONMENT_URL=

# Register this as an Allowed Callback URL under Authentication → Redirect URLs, in the
# SAME environment as SCALEKIT_ENVIRONMENT_URL above. Saving it against the wrong
# environment looks fine and changes nothing:
#
#   http://127.0.0.1:8770/auth/callback
#
# Redirect URLs live in Scalekit's *authentication* product, not AgentKit — different
# sections of the dashboard, reached from the product switcher at the top of the sidebar.

# The connectors this deployment expects, comma-separated, exactly as named in the
# dashboard (AgentKit → Connections). CASE-SENSITIVE: a mismatch returns an empty tool
# list with no error, which reads as "this user has no permissions".
#
# A clinical skill spans services — booking the follow-up *and* logging it to the record
# is one intent across Calendar and HubSpot — which is why this is a list.
SKILLFORGE_CONNECTIONS=gmail,hubspot,calendar

# The identifier tool calls run under. It must be the SAME string the connected accounts
# are filed under, which is why it is normally an email address.
#
# Signing in derives this from the verified token, so in the app the two cannot drift.
# This value is for the scripts, which have no browser session.
#
#   .venv/bin/python scripts/check_connection.py     status, and a fresh auth link
#
# A connected account can EXIST while carrying no token: requesting an authorisation link
# creates the record immediately, so the dashboard shows an account and everything looks
# configured, but until someone completes the OAuth consent its status is PENDING_AUTH
# and every tool call fails with "connected account is not active".
SKILLFORGE_IDENTIFIER_FULL=

# Optional. A second and third identifier with deliberately narrower grants, for showing
# that the same request from two people produces different outcomes. Not needed for the
# clinical demo, where the patient is data rather than an actor.
SKILLFORGE_IDENTIFIER_LIMITED=
SKILLFORGE_IDENTIFIER_PEER=


# ── MeetStream: the bot in the call ───────────────────────────────────────────
# Unlocks: joining a real Google Meet, Zoom or Teams call with streaming transcript and
# real speaker names. One meeting_link covers all three; nothing branches on platform.
# From app.meetstream.ai.
MEETSTREAM_API_KEY=

# The bot's display name in the meeting — what participants actually see arrive.
MEETSTREAM_BOT_NAME=Cura

# Shared secret proving a webhook came from MeetStream. The transcript endpoint sits
# OUTSIDE the login gate by necessity — MeetStream has no cookie — so this is the only
# thing between it and injected transcript lines. Unset, the server rejects every event
# rather than accepting them: an open endpoint here does not leak data, it writes it into
# a patient's record.
#
# Any long random string. Set the same value in MeetStream.
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
MEETSTREAM_WEBHOOK_SECRET=

# MeetStream cannot POST to 127.0.0.1, so a local run needs a public tunnel:
#
#   cloudflared tunnel --url http://127.0.0.1:8770
#
# then pass the printed https URL to scripts/send_bot.py --public. That URL changes every
# time the tunnel restarts, so it is a flag rather than a variable here.
